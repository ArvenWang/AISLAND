{
  "name": "ai-native-island",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:frontend",
    "dev:server": "tsx watch server/index.ts",
    "dev:frontend": "vite",
    "start": "node dist-server/index.js",
    "build": "tsc -p tsconfig.server.json && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "assets:audit": "tsx scripts/map/run.ts audit",
    "map:generate": "tsx scripts/map/run.ts generate",
    "map:validate-source": "tsx scripts/map/run.ts validate",
    "map:build": "tsx scripts/map/run.ts build",
    "map:analyze": "tsx scripts/map/run.ts analyze",
    "map:preview": "tsx scripts/map/run.ts preview",
  "map:all": "npm run map:generate && npm run map:build && npm run map:validate-source && npm run map:validate-transitions && npm run map:analyze && npm run map:preview",
  "map:validate-transitions": "tsx scripts/map/validate-transitions.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --verbose",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --selectProjects unit --verbose",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --selectProjects integration --verbose",
    "test:sim": "tsx tests/sim/run-sim.ts",
    "test:e2e": "playwright test",
    "acceptance:real-api": "tsx tests/acceptance/run-acceptance.ts",
    "acceptance:report": "tsx tests/acceptance/build-report.ts"
  },
  "dependencies": {
    "@pixi/react": "^7.1.0",
    "@pixi/tilemap": "^4.1.0",
    "@tailwindcss/forms": "^0.5.3",
    "@types/react": "18.2.8",
    "@types/react-dom": "18.2.4",
    "clsx": "^2.0.0",
    "dotenv": "^16.1.4",
    "eslint": "8.42.0",
    "pixi-viewport": "^5.0.1",
    "pixi.js": "^7.2.4",
    "pngjs": "^7.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-github-btn": "^1.4.0",
    "react-modal": "^3.16.1",
    "react-toastify": "^9.1.3",
    "typescript": "5.1.3",
    "update-browserslist-db": "^1.1.2",
    "uplot": "^1.6.25",
    "usehooks-ts": "^2.9.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/css-font-loading-module": "^0.0.8",
    "@types/jest": "^29.5.4",
    "@types/node": "^22.20.1",
    "@types/pngjs": "^6.0.5",
    "@types/react-modal": "^3.16.0",
    "@types/ws": "^8.5.5",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "@vitejs/plugin-react": "^4.0.4",
    "autoprefixer": "^10.4.15",
    "concurrently": "^8.2.0",
    "jest": "^29.7.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.28",
    "prettier": "^3.4.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "tsx": "^4.19.2",
    "vite": "^4.4.9"
  }
}

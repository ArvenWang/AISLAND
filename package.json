{
  "name": "ai-native-island",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:frontend",
    "dev:server": "tsx watch server/index.ts",
    "dev:frontend": "vite",
    "start": "node dist-server/index.js",
    "build": "npm run map:phase3:build && tsc -p tsconfig.server.json && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "assets:audit": "tsx scripts/map/run.ts audit",
    "map:generate": "tsx scripts/map/run.ts generate",
    "map:validate-source": "tsx scripts/map/run.ts validate",
    "map:build": "tsx scripts/map/run.ts build",
    "map:analyze": "tsx scripts/map/run.ts analyze",
    "map:preview": "tsx scripts/map/run.ts preview",
    "map:phase3:build": "tsx scripts/map/compile-phase3.ts",
    "map:phase3:validate": "tsx scripts/map/validate-phase3.ts",
    "map:phase3:analyze": "tsx scripts/map/analyze-phase3.ts",
    "map:phase3:all": "npm run map:phase3:build && npm run map:phase3:validate && npm run map:phase3:analyze",
    "asset:terrain:v2:build": "python3 scripts/asset-forge/build_terrain_v2.py",
    "asset:terrain:v2:install": "python3 scripts/asset-forge/build_terrain_v2.py --install",
    "asset:visual:v2:build": "python3 scripts/asset-forge/build_visual_assets_v2.py",
    "asset:visual:v2:install": "python3 scripts/asset-forge/build_visual_assets_v2.py --install",
    "asset:reuse:phase31": "tsx scripts/verify/asset-reuse-audit.ts",
    "phase31:evidence:audit": "tsx scripts/verify/phase31-evidence-audit.ts",
    "verify:phase31": "npm run lint && npm run map:phase3:all && npm run asset:reuse:phase31 && npm run typecheck && npm run test:unit -- --runInBand && npm run test:integration -- --runInBand && npx tsx scripts/verify/static-forbidden-scan.ts && npm run phase31:evidence:audit && npm run build",
    "verify:phase3:live": "tsx scripts/verify/capture-phase3-live.ts",
    "verify:phase3:movement": "tsx scripts/verify/capture-phase3-movement.ts",
    "verify:phase3": "npm run map:phase3:all && npm run typecheck && npm run test:unit && npx tsx scripts/verify/static-forbidden-scan.ts && npm run build",
    "map:all": "npm run map:generate && npm run map:build && npm run map:validate-source && npm run map:validate-transitions && npm run map:analyze && npm run map:preview",
    "map:validate-transitions": "tsx scripts/map/validate-transitions.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --verbose",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --selectProjects unit --verbose",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --selectProjects integration --verbose",
    "test:sim": "tsx tests/sim/run-sim.ts",
    "test:e2e": "playwright test",
    "verify:mvp2": "npm run lint && npm run typecheck && npm run test:unit && npm run test:integration && npm run assets:audit && npx tsx scripts/verify/static-forbidden-scan.ts && npm run map:validate-source && npm run map:build && npm run map:analyze && npm run map:preview && npx tsx scripts/verify/spatial-replay.ts && npx tsx scripts/verify/render-telemetry.ts && npx tsx scripts/verify/visual-regression.ts && npx tsx scripts/verify/performance-smoke.ts && bash scripts/verify/e2e-with-server.sh && npx tsx scripts/verify/acceptance-report.ts",
    "acceptance:real-api": "tsx tests/acceptance/run-acceptance.ts",
    "acceptance:report": "tsx tests/acceptance/build-report.ts"
  },
  "dependencies": {
    "@pixi/react": "^7.1.0",
    "@pixi/tilemap": "^4.1.0",
    "@tailwindcss/forms": "^0.5.3",
    "@types/react": "18.2.8",
    "@types/react-dom": "18.2.4",
    "clsx": "^2.0.0",
    "dotenv": "^16.1.4",
    "eslint": "8.42.0",
    "pixi-viewport": "^5.0.1",
    "pixi.js": "^7.2.4",
    "pngjs": "^7.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-github-btn": "^1.4.0",
    "react-modal": "^3.16.1",
    "react-toastify": "^9.1.3",
    "typescript": "5.1.3",
    "update-browserslist-db": "^1.1.2",
    "uplot": "^1.6.25",
    "usehooks-ts": "^2.9.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/css-font-loading-module": "^0.0.8",
    "@types/jest": "^29.5.4",
    "@types/node": "^22.20.1",
    "@types/pngjs": "^6.0.5",
    "@types/react-modal": "^3.16.0",
    "@types/ws": "^8.5.5",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "@vitejs/plugin-react": "^4.0.4",
    "autoprefixer": "^10.4.15",
    "concurrently": "^8.2.0",
    "jest": "^29.7.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.28",
    "prettier": "^3.4.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "tsx": "^4.19.2",
    "vite": "^4.4.9"
  }
}
